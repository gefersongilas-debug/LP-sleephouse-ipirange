{
  "name": "sleep-house-landing-pages",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev:ipiranga",
    "dev:ipiranga": "npm run dev --workspace @sleep-house/ipiranga",
    "dev:sao-caetano": "npm run dev --workspace @sleep-house/sao-caetano",
    "build": "npm run build --workspaces --if-present",
    "build:ipiranga": "npm run build --workspace @sleep-house/ipiranga",
    "build:sao-caetano": "npm run build --workspace @sleep-house/sao-caetano",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "type": "module"
}
