{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ipiranga", "destination": "/index.html" },
    { "source": "/ipiranga/formulario", "destination": "/index.html" },
    { "source": "/sao-caetano", "destination": "/index.html" },
    { "source": "/sao-caetano/formulario", "destination": "/index.html" },
    { "source": "/formulario/etapas", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:avif|webp|jpg|jpeg|png|svg|woff2|mp4))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
